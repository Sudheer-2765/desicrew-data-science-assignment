# Python Environments & Bytecode
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so

# Test & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# Sensitive Environment Configurations & Secrets
.env
*.env
